generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  phone        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings   Booking[]
  promoCodes PromoCode[]
  freezes    CourseFreeze[]
}

model CourseFreeze {
  id            Int       @id @default(autoincrement())
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseGroupId String
  bookingId     Int?
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  usedAt        DateTime?
}

model StudioDocument {
  id        Int      @id @default(autoincrement())
  title     String
  fileUrl   String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  sid    String   @id
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

model HomeHero {
  id          Int      @id @default(autoincrement())
  title       String   @default("ТРИЕДИНСТВО")
  subtitle    String   @default("Три сферы. Одна система. Тройной эффект")
  subtitle2   String   @default("")
  description String   @default("")
  imageUrl    String?
  faqImageUrl String?
  spheres     Json     @default("[]")
  updatedAt   DateTime @updatedAt
}

model HomeFaq {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  imageUrl  String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomeStep {
  id          Int      @id @default(autoincrement())
  label       String   @default("1 шаг")
  title       String
  description String
  imageUrl    String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Format {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  name            String
  subtitle        String   @default("")
  miniResults     String[]
  previewImageUrl String?
  heroImageUrl    String?
  durationMin     Int      @default(60)
  order           Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  forWhom    ForWhomItem[]
  mechanisms HowItWorksStep[]
  bookings   Booking[]
  slots      Slot[]
  rules      ConditionRule[]
}

enum RiskLevel {
  ALLOWED
  CAUTION
  FORBIDDEN
}

model Condition {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rules ConditionRule[]
}

model ConditionRule {
  id          Int       @id @default(autoincrement())
  conditionId Int
  condition   Condition @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  formatId    Int
  format      Format    @relation(fields: [formatId], references: [id], onDelete: Cascade)
  risk        RiskLevel @default(ALLOWED)
  note        String    @default("")

  @@unique([conditionId, formatId])
}

model ForWhomItem {
  id          Int    @id @default(autoincrement())
  formatId    Int
  format      Format @relation(fields: [formatId], references: [id], onDelete: Cascade)
  title       String
  description String
  order       Int    @default(0)
}

model HowItWorksStep {
  id       Int      @id @default(autoincrement())
  formatId Int
  format   Format   @relation(fields: [formatId], references: [id], onDelete: Cascade)
  number   Int      @default(1)
  title    String
  bullets  String[]
  imageUrl String?
  order    Int      @default(0)
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MediaType {
  NONE
  IMAGE
  VIDEO
}

model Review {
  id         Int          @id @default(autoincrement())
  authorName String
  text       String
  rating     Int?
  mediaUrl   String?
  mediaType  MediaType    @default(NONE)
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

enum BookingStatus {
  PENDING
  PAID
  CANCELLED
}

model Trainer {
  id          Int      @id @default(autoincrement())
  name        String
  role        String   @default("")
  description String   @default("")
  photoUrl    String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  slots         Slot[]
  announcements Announcement[]
}

model Slot {
  id           Int      @id @default(autoincrement())
  startsAt     DateTime
  durationMin  Int      @default(30)
  capacity     Int      @default(7)
  isDiagnostic Boolean  @default(false)
  createdAt    DateTime @default(now())

  formatId Int?
  format   Format? @relation(fields: [formatId], references: [id], onDelete: Cascade)

  trainerId Int?
  trainer   Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  hallId Int?
  hall   Hall? @relation(fields: [hallId], references: [id], onDelete: SetNull)

  bookings Booking[]
}

model StudioPhoto {
  id        Int      @id @default(autoincrement())
  url       String
  caption   String   @default("")
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Hall {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @default("")
  priceSingle Int      @default(0)
  price4      Int      @default(0)
  price8      Int      @default(0)
  price12     Int      @default(0)
  isMain      Boolean  @default(false)
  bookingUrl  String   @default("")
  dayStart    String   @default("09:00")
  dayEnd      String   @default("17:30")
  bufferMin   Int      @default(30)
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  slots   RentalSlot[]
  lessons Slot[]
}

model Service {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @default("")
  price       Int      @default(0)
  durationMin Int?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  slots    RentalSlot[]
  bookings Booking[]
}

model RentalSlot {
  id        Int      @id @default(autoincrement())
  startsAt  DateTime
  endsAt    DateTime
  price     Int      @default(0)
  comment   String   @default("")
  isActive  Boolean  @default(true)
  isAuto    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceId Int?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  hallId Int?
  hall   Hall? @relation(fields: [hallId], references: [id], onDelete: Cascade)

  bookings Booking[]
}

model Booking {
  id             Int           @id @default(autoincrement())
  userId         Int?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  slotId         Int?
  slot           Slot?         @relation(fields: [slotId], references: [id], onDelete: SetNull)
  formatId       Int?
  format         Format?       @relation(fields: [formatId], references: [id], onDelete: SetNull)
  announcementId Int?
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  rentalSlotId   Int?
  rentalSlot     RentalSlot?   @relation(fields: [rentalSlotId], references: [id], onDelete: SetNull)
  serviceId      Int?
  service        Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  promoCodeId    Int?
  promoCode      PromoCode?    @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  name           String
  phone          String
  email          String?
  isCourse       Boolean       @default(false)
  isDiagnostic   Boolean       @default(false)
  courseGroupId  String?
  price          Int           @default(0)
  isFree         Boolean       @default(false)
  status         BookingStatus @default(PENDING)
  createdAt      DateTime      @default(now())
}

enum PromoKind {
  GENERIC
  GIFT
}

model PromoCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  kind      PromoKind @default(GENERIC)
  isUsed    Boolean   @default(false)
  courseGroupId String?
  userId    Int?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String?
  phone     String?
  email     String?
  createdAt DateTime  @default(now())
  expiresAt DateTime  @default(now())
  usedAt    DateTime?

  bookings Booking[]
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @default("")
  startsAt    DateTime
  durationMin Int      @default(60)
  capacity    Int      @default(7)
  price       Int      @default(0)
  isFree      Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  trainerId Int?
  trainer   Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  bookings Booking[]
}

model SiteSettings {
  id               Int      @id @default(1)
  address          String   @default("Малая Никитская ул., 8/1, Москва")
  phone            String   @default("8-888-888-88-88")
  email            String   @default("test@mail.ru")
  courseThreshold  Int      @default(3)
  pricePerSession  Int      @default(5000)
  priceCourse      Int      @default(4000)
  userAgreementUrl String   @default("")
  telegramUrl      String   @default("")
  maxUrl           String   @default("")
  rentPricePerHour Int      @default(3000)
  rentDayStart     String   @default("09:00")
  rentDayEnd       String   @default("17:30")
  rentBufferMin    Int      @default(30)
  bookingEditHours Int      @default(4)
  courseCancelHours Int     @default(12)
  mapLat           Float?
  mapLng           Float?
  updatedAt        DateTime @updatedAt
}
