generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Session {
  sid    String   @id
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

model HomeHero {
  id          Int      @id @default(autoincrement())
  title       String   @default("ТРИЕДИНСТВО")
  subtitle    String   @default("Три сферы. Одна система. Тройной эффект")
  description String   @default("")
  imageUrl    String?
  spheres     Json     @default("[]")
  updatedAt   DateTime @updatedAt
}

model HomeFaq {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  imageUrl  String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomeStep {
  id          Int      @id @default(autoincrement())
  label       String   @default("1 шаг")
  title       String
  description String
  imageUrl    String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Format {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  name            String
  subtitle        String   @default("")
  miniResults     String[]
  previewImageUrl String?
  heroImageUrl    String?
  pricePerSession Int      @default(0)
  priceCourse     Int      @default(0)
  order           Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  forWhom    ForWhomItem[]
  mechanisms HowItWorksStep[]
  bookings   Booking[]
  slots      Slot[]
}

model ForWhomItem {
  id          Int    @id @default(autoincrement())
  formatId    Int
  format      Format @relation(fields: [formatId], references: [id], onDelete: Cascade)
  title       String
  description String
  order       Int    @default(0)
}

model HowItWorksStep {
  id       Int      @id @default(autoincrement())
  formatId Int
  format   Format   @relation(fields: [formatId], references: [id], onDelete: Cascade)
  number   Int      @default(1)
  title    String
  bullets  String[]
  imageUrl String?
  order    Int      @default(0)
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MediaType {
  NONE
  IMAGE
  VIDEO
}

model Review {
  id         Int          @id @default(autoincrement())
  authorName String
  text       String
  rating     Int?
  mediaUrl   String?
  mediaType  MediaType    @default(NONE)
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

enum BookingStatus {
  PENDING
  PAID
  CANCELLED
}

model Slot {
  id           Int      @id @default(autoincrement())
  startsAt     DateTime
  durationMin  Int      @default(30)
  capacity     Int      @default(7)
  isDiagnostic Boolean  @default(false)
  createdAt    DateTime @default(now())

  formatId Int?
  format   Format? @relation(fields: [formatId], references: [id], onDelete: Cascade)

  bookings Booking[]
}

model Booking {
  id             Int           @id @default(autoincrement())
  slotId         Int?
  slot           Slot?         @relation(fields: [slotId], references: [id], onDelete: Cascade)
  formatId       Int?
  format         Format?       @relation(fields: [formatId], references: [id], onDelete: SetNull)
  announcementId Int?
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  promoCodeId    Int?
  promoCode      PromoCode?    @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  name           String
  phone          String
  email          String?
  isCourse       Boolean       @default(false)
  isDiagnostic   Boolean       @default(false)
  courseGroupId  String?
  price          Int           @default(0)
  isFree         Boolean       @default(false)
  status         BookingStatus @default(PENDING)
  createdAt      DateTime      @default(now())
}

enum PromoKind {
  GENERIC
  GIFT
}

model PromoCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  kind      PromoKind @default(GENERIC)
  isUsed    Boolean   @default(false)
  name      String?
  phone     String?
  email     String?
  createdAt DateTime  @default(now())
  expiresAt DateTime  @default(now())
  usedAt    DateTime?

  bookings Booking[]
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @default("")
  imageUrl    String?
  startsAt    DateTime
  capacity    Int      @default(7)
  price       Int      @default(0)
  isFree      Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  bookings Booking[]
}

model SiteSettings {
  id              Int      @id @default(1)
  address         String   @default("Малая Никитская ул., 8/1, Москва")
  phone           String   @default("8-888-888-88-88")
  email           String   @default("test@mail.ru")
  courseThreshold Int      @default(3)
  updatedAt       DateTime @updatedAt
}
